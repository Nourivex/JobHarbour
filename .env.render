# ========================================================
# JobHarbour Production Environment Variables for Render.com
# Salin seluruh isi berkas ini ke tab Environment di Render
# ========================================================

APP_NAME=JobHarbour
APP_ENV=production
APP_KEY=base64:yhlTXKmKu3wv5UNqqLfEpSzhECqwEmZBYozDUZnRsrU=
APP_DEBUG=false
APP_URL=https://jobharbour.onrender.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
BCRYPT_ROUNDS=12

# Logging langsung diarahkan ke standard error agar terbaca di Live Logs Render
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database SQLite Zero-Config (Otomatis dibuat di container)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite
DB_FOREIGN_KEYS=true

# Driver Session, Cache, dan Queue berbasis Database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Seeder Otomatis untuk Akun Demo (Budi, Recruiter, Admin)
SEED_ON_DEPLOY=true
