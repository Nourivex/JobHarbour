# ========================================================
# JobHarbour Production Environment Variables for Render.com
# Salin seluruh isi berkas ini ke tab Environment di Render
# ========================================================

APP_NAME=JobHarbour
APP_ENV=production
APP_KEY=base64:yhlTXKmKu3wv5UNqqLfEpSzhECqwEmZBYozDUZnRsrU=
APP_DEBUG=false
APP_URL=https://jobharbour.onrender.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
BCRYPT_ROUNDS=12

# Logging langsung diarahkan ke standard error agar terbaca di Live Logs Render
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database Supabase PostgreSQL Cloud (Terhubung & Terverifikasi Aktif)
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.irrdaftlsuurdavytuuk
DB_PASSWORD=YilK1yN08w8kaNhD
DB_SSLMODE=require

# Driver Session berbasis Cookie (Aman, cepat, dan mencegah SQLite lock)
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Seeder Otomatis untuk Akun Demo (Budi, Recruiter, Admin)
SEED_ON_DEPLOY=true
